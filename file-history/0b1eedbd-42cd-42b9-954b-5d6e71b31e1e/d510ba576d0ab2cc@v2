def set_font(run, name='仿宋', size=11, bold=False, color=None):
    run.font.name = 'Times New Roman'
    run._element.rPr.rFonts.set(qn('w:eastAsia'), name)
    run.font.size = Pt(size)
    run.font.bold = bold
    if color:
        run.font.color.rgb = RGBColor(*color)

def title(text):
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    set_font(p.add_run(text), '黑体', 16, bold=True)

def h1(text):
    p = doc.add_paragraph()
    p.space_before = Pt(6)
    set_font(p.add_run(text), '黑体', 13, bold=True)

def body(text, indent=False, color=None, bold=False):
    p = doc.add_paragraph()
    if indent:
        p.paragraph_format.first_line_indent = Cm(0.74)
    set_font(p.add_run(text), '仿宋', 11, bold=bold, color=color)

