<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>孙娄东村二期 - 集装箱智能家居体验店商业计划</title>
<style>
  :root {
    --bg: #f5f5f5;
    --card-bg: #ffffff;
    --text: #222;
    --sub: #555;
    --accent: #e8590c;
    --accent2: #1971c2;
    --green: #2b8a3e;
    --red: #c92a2a;
    --border: #dee2e6;
    --tag-bg: #fff4e6;
    --table-stripe: #f8f9fa;
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  body { font-family: "PingFang SC","Microsoft YaHei","Hiragino Sans GB",sans-serif; background:var(--bg); color:var(--text); line-height:1.7; }
  .container { max-width:960px; margin:0 auto; padding:24px 20px 60px; }

  /* Hero */
  .hero { background:linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); color:#fff; border-radius:12px; padding:40px 36px; margin-bottom:28px; position:relative; overflow:hidden; }
  .hero::after { content:''; position:absolute; right:-40px; top:-40px; width:200px; height:200px; background:rgba(255,255,255,0.03); border-radius:50%; }
  .hero h1 { font-size:2em; margin-bottom:8px; letter-spacing:1px; }
  .hero .subtitle { font-size:1.05em; opacity:0.85; margin-bottom:16px; }
  .hero .badges { display:flex; gap:10px; flex-wrap:wrap; }
  .hero .badge { background:rgba(255,255,255,0.15); border:1px solid rgba(255,255,255,0.25); padding:5px 14px; border-radius:20px; font-size:0.85em; }

  /* Sections */
  .section { background:var(--card-bg); border-radius:10px; padding:28px 32px; margin-bottom:20px; box-shadow:0 1px 4px rgba(0,0,0,0.06); }
  .section h2 { font-size:1.35em; color:var(--accent); margin-bottom:16px; padding-bottom:10px; border-bottom:2px solid var(--accent); display:flex; align-items:center; gap:10px; }
  .section h2 .num { background:var(--accent); color:#fff; width:30px; height:30px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:0.85em; flex-shrink:0; }
  .section h3 { font-size:1.1em; margin:18px 0 10px; color:#333; }

  /* Tables */
  table { width:100%; border-collapse:collapse; margin:12px 0; font-size:0.93em; }
  th { background:#f1f3f5; padding:10px 12px; text-align:left; font-weight:600; border:1px solid var(--border); }
  td { padding:9px 12px; border:1px solid var(--border); }
  tr:nth-child(even) td { background:var(--table-stripe); }
  .num-cell { text-align:right; font-variant-numeric:tabular-nums; }

  /* KPI cards */
  .kpi-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:14px; margin:16px 0; }
  .kpi-card { background:var(--tag-bg); border:1px solid var(--border); border-radius:8px; padding:16px; text-align:center; }
  .kpi-card .value { font-size:1.6em; font-weight:700; color:var(--accent); }
  .kpi-card .label { font-size:0.85em; color:var(--sub); margin-top:4px; }

  /* Tags */
  .tag { display:inline-block; background:#e7f5ff; color:var(--accent2); padding:3px 10px; border-radius:4px; font-size:0.82em; margin:2px 4px 2px 0; }
  .tag.warn { background:#fff3cd; color:#856404; }
  .tag.green { background:#d3f9d8; color:var(--green); }
  .tag.red { background:#ffe3e3; color:var(--red); }

  /* Highlights */
  .highlight { background:#fff9db; border-left:4px solid #fcc419; padding:12px 16px; margin:12px 0; border-radius:0 6px 6px 0; font-size:0.93em; }
  .highlight strong { color:var(--accent); }

  /* Flow */
  .flow { display:flex; align-items:center; justify-content:center; gap:8px; flex-wrap:wrap; margin:16px 0; font-size:0.9em; }
  .flow .step { background:var(--accent); color:#fff; padding:8px 16px; border-radius:20px; white-space:nowrap; }
  .flow .arrow { color:var(--accent); font-size:1.3em; }

  /* Responsive */
  @media (max-width:640px) {
    .hero { padding:28px 20px; }
    .hero h1 { font-size:1.5em; }
    .section { padding:20px 18px; }
    .kpi-grid { grid-template-columns:1fr 1fr; }
  }

  .footer { text-align:center; color:#999; font-size:0.82em; margin-top:32px; }
  .footer a { color:var(--accent2); }
</style>
</head>
