<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>第 1 周训练计划 · 减脂 · 82→75 kg</title>
<style>
  :root{
    --bg:#f3f5f7;
    --card:#ffffff;
    --ink:#16202a;
    --ink2:#3d4c5a;
    --muted:#6d7c8a;
    --line:#e4e9ee;
    --teal:#0f766e;
    --teal-soft:#e7f4f1;
    --blue:#1d4ed8;
    --blue-soft:#e8eefc;
    --amber:#b45309;
    --amber-soft:#fdf4e6;
    --gray-soft:#eef1f4;
    --radius:14px;
    --shadow:0 1px 2px rgba(16,32,42,.05),0 6px 18px rgba(16,32,42,.05);
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;padding:0}
  body{
    background:var(--bg);color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
    font-size:15px;line-height:1.6;
    padding-bottom:96px;
  }
  .wrap{max-width:760px;margin:0 auto;padding:0 14px}

  /* ---------- 顶部 ---------- */
  header.top{padding:22px 0 10px}
  .kicker{font-size:12px;letter-spacing:.14em;color:var(--teal);font-weight:700;text-transform:uppercase}
  h1{margin:6px 0 4px;font-size:24px;letter-spacing:-.4px}
  .sub{color:var(--muted);font-size:13.5px}
  .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin:16px 0 12px}
  .stat{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:11px 12px;box-shadow:var(--shadow)}
  .stat b{display:block;font-size:19px;letter-spacing:-.3px;line-height:1.25}
  .stat span{font-size:11.5px;color:var(--muted)}
  .stat.accent b{color:var(--teal)}

  /* ---------- 进度条 ---------- */
  .prog{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:13px 14px;box-shadow:var(--shadow)}
  .prog .row{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px}
  .prog .row b{font-size:15px}
  .prog .row span{font-size:12.5px;color:var(--muted)}
  .bar{height:9px;background:var(--gray-soft);border-radius:99px;overflow:hidden}
  .bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,#0f766e,#2f9e8c);border-radius:99px;transition:width .35s ease}

  /* ---------- 标签 ---------- */
  .tabs{display:flex;gap:8px;margin:16px 0 14px;overflow-x:auto;padding-bottom:2px;scrollbar-width:none}
  .tabs::-webkit-scrollbar{display:none}
  .tab{
    flex:0 0 auto;border:1px solid var(--line);background:var(--card);color:var(--ink2);
    border-radius:11px;padding:9px 13px;font-size:13.5px;font-weight:600;cursor:pointer;
    font-family:inherit;line-height:1.35;text-align:left;transition:.15s;
  }
  .tab small{display:block;font-weight:500;font-size:11px;color:var(--muted)}
  .tab.on{background:var(--ink);color:#fff;border-color:var(--ink)}
  .tab.on small{color:rgba(255,255,255,.62)}
  .tab .today{color:var(--amber);font-size:11px;font-weight:700}
  .tab.on .today{color:#ffd79a}

  /* ---------- 训练日 ---------- */
  .dayhead{display:flex;flex-wrap:wrap;gap:7px;align-items:center;margin:2px 0 12px}
  .pill{font-size:12px;padding:4px 10px;border-radius:99px;font-weight:600;background:var(--gray-soft);color:var(--ink2)}
  .pill.teal{background:var(--teal-soft);color:var(--teal)}
  .pill.blue{background:var(--blue-soft);color:var(--blue)}
  .pill.warn{background:var(--amber-soft);color:var(--amber)}

  .ex{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:14px;margin-bottom:11px;box-shadow:var(--shadow)}
  .ex.done{background:#fbfdfc;border-color:#cfe6e1}
  .ex-h{display:flex;gap:10px;align-items:flex-start}
  .num{flex:0 0 26px;height:26px;border-radius:8px;background:var(--gray-soft);color:var(--muted);
       font-size:12.5px;font-weight:700;display:flex;align-items:center;justify-content:center;margin-top:2px}
  .ex.done .num{background:var(--teal);color:#fff}
  .ex-title{flex:1;min-width:0}
  .ex-title h3{margin:0;font-size:16.5px;letter-spacing:-.2px}
  .big{display:flex;align-items:baseline;gap:6px;margin:3px 0 0;flex-wrap:wrap}
  .big b{font-size:20px;color:var(--teal);letter-spacing:-.5px;font-variant-numeric:tabular-nums}
  .big span{font-size:12.5px;color:var(--muted)}
  .loadline{font-size:12.5px;color:var(--ink2);margin-top:5px}
  .loadline em{font-style:normal;background:var(--amber-soft);color:var(--amber);padding:1px 6px;border-radius:5px;font-size:11.5px;font-weight:600}

  /* 组数按钮 */
  .sets{display:flex;gap:8px;margin:12px 0 10px;flex-wrap:wrap}
  .set{
    flex:1 1 0;min-width:74px;border:1.5px solid var(--line);background:#fff;border-radius:10px;
    padding:9px 6px;font-family:inherit;font-size:12.5px;font-weight:600;color:var(--ink2);
    cursor:pointer;transition:.15s;display:flex;align-items:center;justify-content:center;gap:6px;
  }
  .set .dot{width:13px;height:13px;border-radius:50%;border:1.5px solid #c2ccd4;transition:.15s}
  .set.on{background:var(--teal);border-color:var(--teal);color:#fff}
  .set.on .dot{background:#fff;border-color:#fff}

  .cue{font-size:13px;color:var(--ink2);border-left:2.5px solid var(--teal-soft);padding-left:9px;margin:0 0 8px}
  details{border-top:1px dashed var(--line);padding-top:9px;margin-top:2px}
  summary{cursor:pointer;font-size:12.5px;font-weight:700;color:var(--blue);list-style:none;display:flex;align-items:center;gap:5px}
  summary::-webkit-details-marker{display:none}
  summary::before{content:"▸";display:inline-block;transition:.2s;font-size:11px}
  details[open] summary::before{transform:rotate(90deg)}
  .steps{margin:9px 0 0;padding-left:0;list-style:none;counter-reset:s}
  .steps li{counter-increment:s;position:relative;padding-left:24px;margin-bottom:6px;font-size:13.5px;color:var(--ink2)}
  .steps li::before{
    content:counter(s);position:absolute;left:0;top:1px;width:17px;height:17px;border-radius:50%;
    background:var(--blue-soft);color:var(--blue);font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center
  }
  .err{margin:9px 0 0;font-size:12.5px;color:var(--amber);background:var(--amber-soft);border-radius:9px;padding:8px 10px}
  .restbtn{
    margin-top:10px;width:100%;border:1px solid var(--line);background:#fff;border-radius:10px;
    padding:8px;font-family:inherit;font-size:12.5px;font-weight:600;color:var(--ink2);cursor:pointer
  }
  .restbtn:active{background:var(--gray-soft)}

  .note{background:var(--card);border:1px dashed var(--line);border-radius:var(--radius);padding:12px 14px;font-size:13px;color:var(--ink2);margin:4px 0 12px}

  /* ---------- 折叠区 ---------- */
  .fold{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);margin-bottom:11px;box-shadow:var(--shadow);overflow:hidden}
  .fold>summary{padding:14px;font-size:14.5px;color:var(--ink);font-weight:700;border-top:none}
  .fold>summary::before{color:var(--teal)}
  .fold .body{padding:0 14px 14px;border-top:1px solid var(--line)}
  table{width:100%;border-collapse:collapse;font-size:13px;margin-top:10px}
  th,td{text-align:left;padding:8px 6px;border-bottom:1px solid var(--line);vertical-align:top}
  th{font-size:11.5px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.05em}
  td b{color:var(--teal);font-variant-numeric:tabular-nums}
  .body h4{margin:14px 0 6px;font-size:13px;color:var(--ink)}
  .body p{margin:6px 0;font-size:13px;color:var(--ink2)}
  .body ul{margin:6px 0;padding-left:18px;font-size:13px;color:var(--ink2)}
  .body li{margin-bottom:4px}

  /* ---------- 计时器 ---------- */
  .timerbar{
    position:fixed;left:0;right:0;bottom:0;z-index:50;transform:translateY(110%);
    transition:transform .28s cubic-bezier(.2,.8,.3,1);padding:0 12px 12px;
  }
  .timerbar.show{transform:translateY(0)}
  .timerbar .inner{
    max-width:760px;margin:0 auto;background:var(--ink);color:#fff;border-radius:14px;
    padding:12px 14px;display:flex;align-items:center;gap:12px;box-shadow:0 10px 30px rgba(16,32,42,.28)
  }
  .timerbar .t{font-size:26px;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:-.5px;min-width:74px}
  .timerbar .lbl{flex:1;font-size:12.5px;color:rgba(255,255,255,.72);line-height:1.4}
  .timerbar button{
    background:rgba(255,255,255,.14);border:none;color:#fff;border-radius:9px;padding:8px 12px;
    font-family:inherit;font-size:12.5px;font-weight:600;cursor:pointer
  }
  .timerbar button.stop{background:#fff;color:var(--ink)}

  footer{padding:18px 0 8px;font-size:12px;color:var(--muted);line-height:1.7}
  footer b{color:var(--ink2)}
  .clear{display:block;margin:10px 0 0;background:none;border:1px solid var(--line);border-radius:10px;
         padding:9px 14px;font-family:inherit;font-size:12.5px;color:var(--muted);cursor:pointer}
  @media(max-width:400px){
    .stats{grid-template-columns:1fr 1fr}
    .stats .stat:last-child{grid-column:span 2}
    h1{font-size:21px}
  }
</style>
</head>
<body>
<div class="wrap">

  <header class="top">
    <div class="kicker">第 1 周 · 减脂 · 新手</div>
    <h1>82 kg → 75 kg</h1>
    <div class="sub">178 cm / 30 岁 / 男 · 每周 4 练 · 不跑步</div>

    <div class="stats">
      <div class="stat accent"><b>2355</b><span>每日目标 kcal</span></div>
      <div class="stat"><b>148 g</b><span>蛋白质 / 天</span></div>
      <div class="stat"><b>0.38 kg</b><span>理论周减重</span></div>
    </div>

    <div class="prog">
      <div class="row">
        <b>本周完成度</b>
        <span id="progTxt">0 / 57 组</span>
      </div>
      <div class="bar"><i id="progBar"></i></div>
      <div class="row" style="margin:7px 0 0">
        <span>脂肪 74 g · 碳水 275 g</span>
        <span id="progPct">0%</span>
      </div>
    </div>
  </header>

  <nav class="tabs" id="tabs"></nav>
  <div id="dayView"></div>

  <!-- 有氧 -->
  <div class="note">
    <b>有氧：每周 3 次 × 25 分钟</b>（快走 / 爬楼，能说话但不喘）。不跑步不影响减脂，走路不算偷懒。<br>
    办公室那天可以压到 40 分钟版：每组间歇缩到 60 秒，或平板支撑减一组。做完算完成。
  </div>

  <details class="fold">
    <summary>饮食怎么吃（2355 kcal 配额）</summary>
    <div class="body">
      <table>
        <tr><th>餐</th><th>蛋白</th><th>参考份量</th></tr>
        <tr><td>早</td><td><b>35 g</b></td><td>鸡蛋 2 个 + 牛奶/无糖豆浆 300 ml + 燕麦 50 g（干重）</td></tr>
        <tr><td>午</td><td><b>45 g</b></td><td>米饭 150 g（熟重）+ 瘦肉/鸡胸 150 g + 蔬菜 300 g，少油</td></tr>
        <tr><td>加餐</td><td><b>25 g</b></td><td>希腊酸奶 150 g 或牛奶 + 坚果 15 g</td></tr>
        <tr><td>晚</td><td><b>43 g</b></td><td>主食 100 g（熟重）+ 鱼/豆腐 150 g + 蔬菜 300 g</td></tr>
      </table>
      <h4>不用称重就用手掌法</h4>
      <p>蛋白 = 1 掌心 ｜ 主食 = 1 拳 ｜ 蔬菜 = 2 捧</p>
      <h4>替换原则（别死守食谱）</h4>
      <ul>
        <li>蛋白类随便换：鸡胸 / 鱼 / 虾 / 瘦牛肉 / 鸡蛋 / 豆腐，按同份量换</li>
        <li>主食等量换：米饭 ↔ 面 ↔ 红薯 ↔ 玉米</li>
        <li>油是隐形大头：一天烹调用油控制在 25 g 以内（约 2.5 瓷勺）</li>
      </ul>
    </div>
  </details>

  <details class="fold">
    <summary>睡眠与恢复</summary>
    <div class="body">
      <ul>
        <li>目标 <b>7–9 小时</b>，23:30 前躺下</li>
        <li>睡前 90 分钟：不吃高糖、不刷手机</li>
        <li>晚上练完至少留 90 分钟再睡，否则入睡变慢</li>
        <li>连续两晚睡不足 6 小时，当天训练降到 2 组，别硬顶</li>
      </ul>
    </div>
  </details>

  <details class="fold">
    <summary>第 2–4 周会怎么变（先知道，不慌）</summary>
    <div class="body">
      <table>
        <tr><th>周</th><th>方向</th><th>可预期变化</th></tr>
        <tr><td>W2</td><td>渐进负荷：俯卧撑 8→12 次封顶后改下斜；壶铃深蹲做到 12 次后加离心 3 秒</td><td>深蹲后两天大腿前侧明显酸</td></tr>
        <tr><td>W3</td><td>容量峰值：每个动作加 1 组</td><td>体重可能 2–3 天不动，那是水不是脂肪。这周也是最容易放弃的一周</td></tr>
        <tr><td>W4</td><td>减载 / 测试周：组数减半，测最大次数</td><td>之后按新体重重算基线</td></tr>
      </table>
      <p style="margin-top:10px">第 2 周起按你的实际完成率调，比一次性发 4 周通用模板准。</p>
    </div>
  </details>

  <details class="fold">
    <summary>周日复盘表（1 分钟填完）</summary>
    <div class="body">
      <table>
        <tr><th>体重</th><th>腰围</th><th>完成几次</th><th>睡眠均值</th><th>饥饿感 1-5</th><th>卡点</th></tr>
        <tr><td>&nbsp;</td><td></td><td></td><td></td><td></td><td></td></tr>
      </table>
      <p style="margin-top:10px">下一个里程碑：<b>81.3 kg</b>（每减 0.7 kg 一个里程碑，共 7 kg）。</p>
    </div>
  </details>

  <footer>
    <b>强度口径</b>：RIR 3 —— 每组结束时还能再做 3 次。第一次练完把「实际做了几次」记下来，这就是校准。<br>
    <b>负荷来源</b>：去脂体重 64.2 kg（体脂 21.8%，Deurenberg 公式估算；由 178 cm / 82 kg / 30 岁 / 男 推出）。<br>
    <b>器材上限</b>：标注「器材上限」的动作，是脚本按可调哑铃算出的重量超出你手上的 3 kg，改用自重或高次数替代，强度上限低一些。<br><br>
    本计划为通用健康成年人参考，特殊人群（孕妇 / 慢病 / 术后 / BMI 异常）请先就医；训练中出现心慌、头晕、关节痛立即停止并咨询医生。<br>
    <button class="clear" id="clearBtn">清空本周打勾记录</button>
  </footer>
</div>

<div class="timerbar" id="timerbar">
  <div class="inner">
    <div class="t" id="timerT">1:30</div>
    <div class="lbl" id="timerLbl">间歇</div>
    <button id="timerStop">停</button>
  </div>
</div>

<script>
const PLAN = [
  {
    id:"d2", day:"周一", time:"20:00", place:"家", theme:"下肢 · 壶铃", kind:"teal", est:"约 55 分钟",
    moves:[
      { n:"高脚杯深蹲", sets:3, reps:"8-12", load:"10 kg 壶铃", ok:true, rest:90,
        cue:"抱铃于胸前，肘在膝内侧，全程挺胸",
        steps:[
          "双手捧住壶铃两侧把手，抱在锁骨下方，肘尖朝下内收。",
          "双脚略宽于肩，脚尖外撇 15–20°，全脚掌踩实。",
          "屈髋同时屈膝下蹲，臀部向下向后，蹲到大腿接近与地面平行。",
          "脚跟发力起身，起身末段夹臀，不要弓背。"
        ],
        err:"常见错误：塌腰、膝盖内扣、脚跟离地。蹲不下去先减小幅度，别硬压。"},
      { n:"壶铃罗马尼亚硬拉", sets:3, reps:"15-20", load:"10 kg 壶铃 · 双手", ok:false, rest:90,
        cue:"壶铃贴腿下滑，臀向后推，背始终是直的",
        steps:[
          "双手握壶铃立于体前，双脚与髋同宽，膝盖微屈后固定住角度。",
          "臀部向后推，壶铃沿大腿前侧下滑，感受大腿后侧被拉长。",
          "下到躯干接近水平、或后侧张力到极限即停（不要靠弯腰贪幅度）。",
          "夹臀把身体拉回站直，顶部收紧 1 秒。"
        ],
        err:"常见错误：弓背、用腰发力、壶铃离开身体。这组重量偏轻，用 3 秒慢下补强度。"},
      { n:"保加利亚分腿蹲", sets:3, reps:"8-12", load:"徒手 / 持 3 kg", ok:false, rest:90,
        cue:"重心压在前腿脚跟，前膝对脚尖",
        steps:[
          "后脚背搭在沙发或椅子边缘，前脚向前迈一大步（约一条腿长）。",
          "躯干保持直立，重心落在前脚脚跟。",
          "垂直下沉，后膝朝地面接近，前膝方向对准脚尖。",
          "前腿发力起身。每侧做完再换边。"
        ],
        err:"常见错误：前脚离太近导致膝盖前顶疼、身体前倾塌腰。新手先完全徒手。"},
      { n:"单腿臀桥", sets:3, reps:"8-12", load:"自重", ok:false, rest:60,
        cue:"骨盆保持水平，不旋转，顶到髋伸到底",
        steps:[
          "仰卧屈膝，一脚踩地，另一条腿抬起或伸直。",
          "收腹，踩地那只脚的脚跟发力顶髋。",
          "顶到躯干与大腿成一条线，顶峰夹臀 1 秒。",
          "慢下到臀部接近地面，不落地。每侧一组。"
        ],
        err:"常见错误：用腰硬顶、骨盆左右倾斜、下巴抬起。"},
      { n:"死虫式", sets:3, reps:"10 / 侧", load:"自重", ok:false, rest:60,
        cue:"腰始终贴地，对侧手脚缓慢伸展",
        steps:[
          "仰卧，双臂垂直指向天花板，髋膝各屈 90°。",
          "轻收下巴，腰部压向地面，全程不许离地。",
          "对侧手和腿同时缓慢向远处伸展到接近地面。",
          "回到起始位，换另一侧。全程呼吸不憋。"
        ],
        err:"常见错误：腰离地、速度过快。腰一离地就减小幅度。"}
    ]
  },
  {
    id:"d1", day:"周二", time:"12:30", place:"办公室", theme:"上肢 · 推拉", kind:"blue", est:"约 45 分钟",
    moves:[
      { n:"俯卧撑", sets:3, reps:"8-12", load:"自重", ok:true, rest:90,
        cue:"身体一条线，肘不外翻，胸贴地再起",
        steps:[
          "双手撑地略宽于肩，手指朝前，头、背、臀、脚跟成一条线。",
          "屈肘下沉，肘与身体夹角约 45°（不是 90° 外张）。",
          "胸部接近地面（一拳距离）再推起，肩胛保持稳定。",
          "做不动就膝盖着地，或把双手撑在办公桌边缘降低难度。"
        ],
