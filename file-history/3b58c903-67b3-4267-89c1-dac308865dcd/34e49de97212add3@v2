const KEY = "lx_w1_2026_11_16";
const store = JSON.parse(localStorage.getItem(KEY) || "{}");
let cur = 0;
const todayIdx = (new Date().getDay() + 6) % 7; // 周一=0
const todayMap = [0, 1, null, 2, null, 3, null]; // 周一/周二/周四/周六

function totalSets(){ return PLAN.reduce((a,d)=>a+d.moves.reduce((b,m)=>b+m.sets,0),0); }

function renderTabs(){
  const tabs = document.getElementById("tabs");
  tabs.innerHTML = PLAN.map((d,i)=>{
    const isToday = todayMap[todayIdx] === i;
    return `<button class="tab ${i===cur?"on":""}" data-i="${i}">
      ${d.day}${isToday?' <span class="today">今天</span>':''}
      <small>${d.place} · ${d.theme}</small>
    </button>`;
  }).join("");
  tabs.querySelectorAll(".tab").forEach(b=>b.onclick=()=>{ cur=+b.dataset.i; renderTabs(); renderDay(); });
}

function renderDay(){
  const d = PLAN[cur];
  const done = d.moves.reduce((a,m,i)=>a+m.sets,0);
  let html = `<div class="dayhead">
      <span class="pill ${d.kind}">${d.day} ${d.time}</span>
      <span class="pill">${d.place}</span>
      <span class="pill">${d.theme}</span>
      <span class="pill">${d.est}</span>
    </div>`;

  d.moves.forEach((m,mi)=>{
    let onCount = 0;
    const btns = Array.from({length:m.sets},(_,si)=>{
      const on = !!store[`${d.id}-${mi}-${si}`];
      if(on) onCount++;
      return `<button class="set ${on?"on":""}" data-k="${d.id}-${mi}-${si}"><span class="dot"></span>第 ${si+1} 组</button>`;
    }).join("");

    html += `<article class="ex ${onCount===m.sets?"done":""}">
      <div class="ex-h">
        <div class="num">${mi+1}</div>
        <div class="ex-title">
          <h3>${m.n}</h3>
          <div class="big"><b>${m.sets} × ${m.reps}</b><span>${m.sets} 组 × ${m.reps}${m.reps.includes("秒")||m.reps.includes("步")||m.reps.includes("侧")?"":" 次"}</span></div>
          <div class="loadline">负荷 ${m.load} · 间歇 ${m.rest} 秒 ${m.ok?"":"<em>器材上限</em>"}</div>
        </div>
      </div>
      <div class="sets">${btns}</div>
      <p class="cue">${m.cue}</p>
      <details>
        <summary>怎么做 · 分步与常见错误</summary>
        <ol class="steps">${m.steps.map(s=>`<li>${s}</li>`).join("")}</ol>
        <div class="err">${m.err}</div>
      </details>
      <button class="restbtn" data-rest="${m.rest}" data-name="${m.n}">间歇计时 ${m.rest} 秒</button>
    </article>`;
  });

  document.getElementById("dayView").innerHTML = html;

  document.querySelectorAll(".set").forEach(b=>{
    b.onclick = ()=>{
      const k = b.dataset.k;
      if(store[k]) delete store[k]; else store[k]=1;
      localStorage.setItem(KEY, JSON.stringify(store));
      renderDay(); updateProg();
    };
  });
  document.querySelectorAll(".restbtn").forEach(b=>{
    b.onclick = ()=> startRest(+b.dataset.rest, b.dataset.name);
  });
}

function updateProg(){
  let done=0; const tot=totalSets();
  PLAN.forEach(d=>d.moves.forEach((m,mi)=>{
    for(let si=0;si<m.sets;si++) if(store[`${d.id}-${mi}-${si}`]) done++;
  }));
  const pct = Math.round(done/tot*100);
  document.getElementById("progTxt").textContent = `${done} / ${tot} 组`;
  document.getElementById("progPct").textContent = pct + "%";
  document.getElementById("progBar").style.width = pct + "%";
}

/* 间歇计时 */
let tid=null, left=0;
const tb = document.getElementById("timerbar");
const tT = document.getElementById("timerT");
const tL = document.getElementById("timerLbl");

function fmt(s){ return Math.floor(s/60) + ":" + String(s%60).padStart(2,"0"); }
function startRest(sec, name){
  clearInterval(tid);
  left = sec;
  tT.textContent = fmt(left);
  tL.textContent = name + " · 间歇中";
  tb.classList.add("show");
  tid = setInterval(()=>{
    left--;
    tT.textContent = fmt(Math.max(left,0));
    if(left<=0){
      clearInterval(tid); tid=null;
      tT.textContent = "0:00";
      tL.textContent = "时间到 · 下一组";
      beep();
      if(navigator.vibrate) navigator.vibrate([180,90,180]);
      setTimeout(()=>tb.classList.remove("show"), 5000);
    }
  },1000);
}
function beep(){
  try{
    const C = window.AudioContext || window.webkitAudioContext;
    const ctx = new C();
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.connect(g); g.connect(ctx.destination);
    o.type="sine"; o.frequency.value=880;
    g.gain.setValueAtTime(.0001, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(.25, ctx.currentTime+.02);
    g.gain.exponentialRampToValueAtTime(.0001, ctx.currentTime+.45);
    o.start(); o.stop(ctx.currentTime+.5);
  }catch(e){}
}
document.getElementById("timerStop").onclick = ()=>{
  clearInterval(tid); tid=null; tb.classList.remove("show");
};
document.getElementById("clearBtn").onclick = ()=>{
  if(!confirm("清空本周所有打勾记录？")) return;
  Object.keys(store).forEach(k=>delete store[k]);
  localStorage.setItem(KEY,"{}");
  renderDay(); updateProg();
};

renderTabs(); renderDay(); updateProg();
