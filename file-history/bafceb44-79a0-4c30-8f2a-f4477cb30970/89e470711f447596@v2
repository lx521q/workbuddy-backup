def tag(draw, xy, title, sub, color, anchor='lt', bw=None):
    """draw a label box with leader; xy is anchor point on the photo"""
    x, y = xy
    tfont = f(30, True)
    sfont = f(23)
    tw = draw.textlength(title, font=tfont)
    sw = draw.textlength(sub, font=sfont) if sub else 0
    w = int(max(tw, sw)) + 28
    h = 84 if sub else 58
    if bw:
        w = bw
    # box position
    bx, by = x, y
    if anchor == 'rt':
        bx = x - w
    elif anchor == 'ct':
        bx = x - w // 2
    if anchor.startswith('b'):
        by = y - h
    draw.rounded_rectangle([bx, by, bx + w, by + h], 10, fill=C_BG, outline=color, width=3)
    draw.rectangle([bx, by, bx + 6, by + h], fill=color)
    if sub:
        draw.text((bx + 18, by + 8), title, font=tfont, fill=color)
        draw.text((bx + 18, by + 46), sub, font=sfont, fill=C_DIM)
    else:
        draw.text((bx + 18, by + 12), title, font=tfont, fill=color)
    return (bx, by, bx + w, by + h)

def leader(draw, p1, p2, color, width=3):
    draw.line([p1, p2], fill=color, width=width)
    # dot at pipe end
    r = 7
    draw.ellipse([p2[0]-r, p2[1]-r, p2[0]+r, p2[1]+r], fill=color)

def dimline(draw, p1, p2, color, label):
    """double arrow dimension line with label at midpoint"""
    draw.line([p1, p2], fill=color, width=3)
    for p in (p1, p2):
        draw.ellipse([p[0]-6, p[1]-6, p[0]+6, p[1]+6], fill=color)
    mx, my = (p1[0]+p2[0])//2, (p1[1]+p2[1])//2
    fnt = f(26, True)
    tw = draw.textlength(label, font=fnt)
    draw.rectangle([mx-tw//2-10, my-20, mx+tw//2+10, my+20], fill=C_BG)
    draw.text((mx-tw//2, my-15), label, font=fnt, fill=color)

