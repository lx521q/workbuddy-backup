def _align(a):
    return {'center': WD_ALIGN_PARAGRAPH.CENTER,
            'left': WD_ALIGN_PARAGRAPH.LEFT,
            'right': WD_ALIGN_PARAGRAPH.RIGHT,
            'just': WD_ALIGN_PARAGRAPH.JUSTIFY}[a]


def set_run_font(run, size=10.5, bold=False, font=SONG, color=None):
    run.font.name = font
    run.font.size = Pt(size)
    run.font.bold = bold
    if color:
        run.font.color.rgb = RGBColor(*color)
    rPr = run._element.get_or_add_rPr()
    rFonts = rPr.find(qn('w:rFonts'))
    if rFonts is None:
        rFonts = parse_xml('<w:rFonts %s w:ascii="%s" w:hAnsi="%s" w:eastAsia="%s"/>'
                           % (nsdecls('w'), font, font, font))
        rPr.append(rFonts)
    else:
        rFonts.set(qn('w:ascii'), font)
        rFonts.set(qn('w:hAnsi'), font)
        rFonts.set(qn('w:eastAsia'), font)


def para(doc, text, size=10.5, bold=False, font=SONG, align='just',
         before=0, after=0, indent=False, color=None, line=1.3):
    p = doc.add_paragraph()
    p.alignment = _align(align)
    pf = p.paragraph_format
    pf.space_before = Pt(before)
    pf.space_after = Pt(after)
    pf.line_spacing = line
    if indent:
        pf.first_line_indent = Pt(size * 2)
    r = p.add_run(text)
    set_run_font(r, size, bold, font, color)
    return p


def set_cell(cell, text, size=9, bold=False, align='center', font=SONG, color=None):
    if isinstance(text, (int, float)):
        text = str(text)
    cell.text = ''
    p0 = cell.paragraphs[0]
    for i, ln in enumerate(str(text).split('\n')):
        p = p0 if i == 0 else cell.add_paragraph()
        p.alignment = _align(align)
        p.paragraph_format.space_before = Pt(1)
        p.paragraph_format.space_after = Pt(1)
        p.paragraph_format.line_spacing = 1.05
        r = p.add_run(ln)
        set_run_font(r, size, bold, font, color)
    cell.vertical_alignment = WD_ALIGN_VERTICAL.CENTER


def set_cell_bg(cell, hexcolor):
    tcPr = cell._tc.get_or_add_tcPr()
    shd = parse_xml('<w:shd %s w:val="clear" w:color="auto" w:fill="%s"/>'
                    % (nsdecls('w'), hexcolor))
    tcPr.append(shd)


def set_table_borders(table, sz=4, color='000000'):
    borders = parse_xml(
        '<w:tblBorders %s>'
        '<w:top w:val="single" w:sz="%d" w:space="0" w:color="%s"/>'
        '<w:left w:val="single" w:sz="%d" w:space="0" w:color="%s"/>'
        '<w:bottom w:val="single" w:sz="%d" w:space="0" w:color="%s"/>'
        '<w:right w:val="single" w:sz="%d" w:space="0" w:color="%s"/>'
        '<w:insideH w:val="single" w:sz="%d" w:space="0" w:color="%s"/>'
        '<w:insideV w:val="single" w:sz="%d" w:space="0" w:color="%s"/>'
        '</w:tblBorders>'
        % (nsdecls('w'), sz, color, sz, color, sz, color, sz, color,
           sz, color, sz, color))
    table._tbl.tblPr.append(borders)


def make_table(doc, nrows, ncols, widths_cm):
    t = doc.add_table(rows=nrows, cols=ncols)
    t.alignment = 1
    t.autofit = False
    set_table_borders(t)
    for row in t.rows:
        for i, w in enumerate(widths_cm):
            if i < len(row.cells):
                row.cells[i].width = Cm(w)
    return t


def head_table(doc, headers, widths, size=9):
    t = make_table(doc, 1, len(headers), widths)
    for i, h in enumerate(headers):
        set_cell(t.cell(0, i), h, size, True)
        set_cell_bg(t.cell(0, i), 'D9D9D9')
    return t


def add_rows(t, rows, starts, aligns, size=9):
    t.add_row()
    ri = len(t.rows) - 1
    for ci, v in enumerate(rows):
        set_cell(t.cell(ri, ci), v, size, ci == 0, aligns[ci])
    return ri


