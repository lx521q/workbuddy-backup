# Only write to non-merged cells: C/D columns and A/B/G columns

def set_cell(row, col, value, wrap=True):
    """Set cell value preserving existing font/border, updating alignment"""
    cell = ws.cell(row, col)
    cell.value = value
    # Preserve existing font
    old_font = cell.font
    cell.font = Font(name=old_font.name, size=old_font.size, bold=old_font.bold)
    # Preserve existing border
    old_border = cell.border
    thin = Side(style='thin')
    cell.border = Border(left=thin, right=thin, top=thin, bottom=thin)
    # Set alignment
    cell.alignment = Alignment(
        horizontal='left' if col in (2, 3) else 'center',
        vertical='center',
        wrap_text=wrap
    )

