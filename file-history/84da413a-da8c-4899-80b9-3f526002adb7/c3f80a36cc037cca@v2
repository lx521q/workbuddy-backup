def set_cell_border(cell, **kwargs):
    """设置单元格边框"""
    tc = cell._tc
    tcPr = tc.get_or_add_tcPr()
    tcBorders = OxmlElement('w:tcBorders')
    for edge in ('start', 'top', 'end', 'bottom', 'insideH', 'insideV'):
        edge_data = kwargs.get(edge)
        if edge_data:
            element = OxmlElement(f'w:{edge}')
            for attr in ['sz', 'val', 'color', 'space']:
                if attr in edge_data:
                    element.set(qn(f'w:{attr}'), str(edge_data[attr]))
            tcBorders.append(element)
    tcPr.append(tcBorders)

def set_cell_shading(cell, color):
    """设置单元格底色"""
    tc = cell._tc
    tcPr = tc.get_or_add_tcPr()
    shading = OxmlElement('w:shd')
    shading.set(qn('w:fill'), color)
    shading.set(qn('w:val'), 'clear')
    tcPr.append(shading)

def set_cell_text(cell, text, bold=False, font_size=11, font_name='宋体', alignment=None, color=None):
    """设置单元格文本格式"""
    cell.text = ''
    p = cell.paragraphs[0]
    if alignment is not None:
        p.alignment = alignment
    run = p.add_run(text)
    run.bold = bold
    run.font.size = Pt(font_size)
    run.font.name = font_name
    run._element.rPr.rFonts.set(qn('w:eastAsia'), font_name)
    if color:
        run.font.color.rgb = color

def add_heading_row(table, cells_data, bg_color='4472C4'):
    """添加表头行（蓝底白字）"""
    row = table.add_row()
    for i, text in enumerate(cells_data):
        cell = row.cells[i]
        cell._element.get_or_add_tcPr()
        set_cell_shading(cell, bg_color)
        set_cell_text(cell, text, bold=True, font_size=11, color=RGBColor(255, 255, 255),
                       alignment=WD_ALIGN_PARAGRAPH.CENTER)
    return row

def add_data_row(table, cells_data, bold_first=True):
    """添加数据行"""
    row = table.add_row()
    for i, text in enumerate(cells_data):
        cell = row.cells[i]
        is_bold = bold_first and i == 0
        align = WD_ALIGN_PARAGRAPH.CENTER if i == 0 else WD_ALIGN_PARAGRAPH.LEFT
        set_cell_text(cell, text, bold=is_bold, font_size=10.5, alignment=align)
    return row

def merge_cells(table, row_start, col_start, row_end, col_end, text=''):
    """合并单元格并设置文本"""
    cell_start = table.cell(row_start, col_start)
    cell_end = table.cell(row_end, col_end)
    cell_start.merge(cell_end)
    # 清理合并后单元格
    for p in cell_start.paragraphs:
        p.clear()
    cell_start.paragraphs[0].alignment = WD_ALIGN_PARAGRAPH.LEFT
    run = cell_start.paragraphs[0].add_run(text)
    run.font.size = Pt(10.5)
    run.font.name = '宋体'
    run._element.rPr.rFonts.set(qn('w:eastAsia'), '宋体')

