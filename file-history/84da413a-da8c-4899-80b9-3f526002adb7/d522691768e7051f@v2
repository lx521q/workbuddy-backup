import os

script_path = r'C:\Users\62628\WorkBuddy\2026-08-05-10-25-06\plot_final.scr'

# Build the plot script using COM API (same as plot4.scr which worked before)
# Key: PlotType=1 (acExtents), PlotWithPlotStyles=false (color output)
lines = [
    '(setvar "FILEDIA" 0)',
    '(setvar "CMDDIA" 0)',
    '(setvar "BACKGROUNDPLOT" 0)',
    '(vl-load-com)',
    '(command "_.ZOOM" "_E")',
    '(setq acad (vlax-get-acad-object))',
    '(setq doc (vla-get-ActiveDocument acad))',
    '(setq lay (vla-get-ActiveLayout doc))',
    '(vl-catch-all-apply \'vla-RefreshPlotDeviceInfo (list lay))',
    '(vl-catch-all-apply \'vla-put-ConfigName (list lay "DWG To PDF.pc3"))',
    '(setq r1 (vl-catch-all-apply \'vla-put-PlotType (list lay 1)))',
    '(vl-catch-all-apply \'vla-put-StandardScale (list lay 0))',
    '(vl-catch-all-apply \'vla-put-CenterPlot (list lay :vlax-true))',
    '(vl-catch-all-apply \'vla-put-PlotWithPlotStyles (list lay :vlax-false))',
    '(vl-catch-all-apply \'vla-put-PlotRotation (list lay 0))',
    '(setq f (open "C:\\\\Users\\\\62628\\\\WorkBuddy\\\\2026-08-05-10-25-06\\\\plot_log.txt" "w"))',
    '(write-line (strcat "ConfigName: " (vla-get-ConfigName lay)) f)',
    '(write-line (strcat "PlotType: " (itoa (vla-get-PlotType lay))) f)',
    '(write-line (strcat "PlotWithPlotStyles: " (vl-princ-to-string (vla-get-PlotWithPlotStyles lay))) f)',
    '(write-line "Starting PlotToFile..." f)',
    '(setq plt (vla-get-Plot doc))',
    '(setq pdfPath "C:\\\\Users\\\\62628\\\\WorkBuddy\\\\2026-08-05-10-25-06\\\\color_output.pdf")',
    '(setq plotResult (vl-catch-all-apply \'vla-PlotToFile (list plt pdfPath)))',
    '(if (vl-catch-all-error-p plotResult)',
    '  (write-line (strcat "ERROR: " (vl-catch-all-error-message plotResult)) f)',
    '  (write-line "PlotToFile OK" f)',
    ')',
    '(setq fileSize (vl-file-size pdfPath))',
    '(write-line (strcat "PDF size: " (itoa fileSize) " bytes") f)',
    '(close f)',
    '(command "_.QUIT" "_N")',
]

with open(script_path, 'w', encoding='ascii') as f:
    for line in lines:
        f.write(line + '\n')

print(f'Plot script written to {script_path}')
print(f'Lines: {len(lines)}')
