def add_para(text, size=10.5, bold=False, align='left', indent=True):
    p = doc.add_paragraph()
    p.alignment = {'left': 0, 'center': 1, 'right': 2}[align]
    if indent:
        p.paragraph_format.first_line_indent = Pt(size * 2)
    p.paragraph_format.space_after = Pt(3)
    r = p.add_run(text)
    from docx_helpers import set_run_font
    set_run_font(r, size, bold, SONG)
    return p


