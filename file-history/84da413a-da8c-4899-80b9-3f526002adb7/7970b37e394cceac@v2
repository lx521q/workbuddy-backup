def add_para(doc, text, size=10.5, bold=False, indent=True, align='left',
             font=SONG, space_after=4):
    p = doc.add_paragraph()
    p.alignment = {'left': WD_ALIGN_PARAGRAPH.LEFT,
                   'center': WD_ALIGN_PARAGRAPH.CENTER}[align]
    if indent:
        p.paragraph_format.first_line_indent = Pt(size * 2)
    p.paragraph_format.space_after = Pt(space_after)
    p.paragraph_format.line_spacing = 1.3
    run = p.add_run(text)
    set_run_font(run, size, bold, font)
    return p


def head_row(table, r, texts, size=9.5):
    for c, t in enumerate(texts):
        set_cell(table.cell(r, c), t, size, True)
        set_cell_bg(table.cell(r, c), FILL)


def fill_row(table, r, texts, size=9, bold=False, aligns=None):
