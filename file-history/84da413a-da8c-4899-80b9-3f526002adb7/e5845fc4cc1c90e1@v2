def add_numbered(doc, text, size=10.5, bold=False, first_line=0.74):
    p = doc.add_paragraph()
    p.paragraph_format.first_line_indent = Cm(first_line)
    run = p.add_run(text)
    set_run_font(run, size, bold, SONG)
    return p

def add_plain(doc, text, size=10.5, bold=False):
    p = doc.add_paragraph()
    run = p.add_run(text)
    set_run_font(run, size, bold, SONG)
    return p

