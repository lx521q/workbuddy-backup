def build_banzu_table(doc, title, start_day, end_day, content):
    """班组级每日排查表（白/夜双列）
    start_day~end_day: 日期范围（如 1~16），每天2列（白/夜）
    """
    add_heading(doc, title, 14, HEI, 4, 4)
    add_note(doc, '（记录受控号）单位：运行车间（废油蒸馏）                     '
                  '排查人：___________     班组长：___________')
    n_days = end_day - start_day + 1
    n_rec = n_days * 2                       # 记录列数（白/夜）
    ncols = 4 + n_rec                        # 序号|名称|标准|管控 + 记录
    widths = [0.9, 3.4, 4.8, 5.0] + [0.4] * n_rec
    nrows = 3 + len(content) + 2 + 6         # 表头3行 + 内容 + 签字2行 + 记录区6行
    table = make_table(doc, nrows, ncols, widths)

    # 第1行：大表头
    merge_range(table, 0, 0, 0, 3)
    set_cell(table.cell(0, 0), '排查内容与排查标准', 9, True)
    set_cell_bg(table.cell(0, 0), 'D9D9D9')
    merge_range(table, 0, 4, 0, ncols - 1)
    set_cell(table.cell(0, 4), '隐患排查记录（无隐患填√，发现隐患做标记并在下方记录，不涉及时填/，休息日填）', 8, True)
    set_cell_bg(table.cell(0, 4), 'D9D9D9')

    # 第2行：检查项目|标准|管控措施|日期数字（跨白夜2列）
    merge_range(table, 1, 0, 1, 1)
    set_cell(table.cell(1, 0), '检查项目', 8, True)
    set_cell_bg(table.cell(1, 0), 'F2F2F2')
    set_cell(table.cell(1, 2), '标准', 8, True)
    set_cell_bg(table.cell(1, 2), 'F2F2F2')
    set_cell(table.cell(1, 3), '管控措施', 8, True)
    set_cell_bg(table.cell(1, 3), 'F2F2F2')
    for d in range(n_days):
        c0 = 4 + d * 2
        merge_range(table, 1, c0, 1, c0 + 1)
        set_cell(table.cell(1, c0), str(start_day + d), 8, True)
        set_cell_bg(table.cell(1, c0), 'F2F2F2')

    # 第3行：序号|名称|白|夜|白|夜...
    set_cell(table.cell(2, 0), '序号', 8, True)
    set_cell_bg(table.cell(2, 0), 'F2F2F2')
    set_cell(table.cell(2, 1), '名称', 8, True)
    set_cell_bg(table.cell(2, 1), 'F2F2F2')
    set_cell(table.cell(2, 2), '', 8)
    set_cell(table.cell(2, 3), '', 8)
    for d in range(n_days):
        set_cell(table.cell(2, 4 + d * 2), '白', 7.5, True)
        set_cell(table.cell(2, 4 + d * 2 + 1), '夜', 7.5, True)
        set_cell_bg(table.cell(2, 4 + d * 2), 'F2F2F2')
        set_cell_bg(table.cell(2, 4 + d * 2 + 1), 'F2F2F2')

    # 内容行
    for r, (name, std, ctrl) in enumerate(content, 3):
        set_cell(table.cell(r, 0), str(r - 2), 8)
        set_cell(table.cell(r, 1), name, 8, False, 'left')
        set_cell(table.cell(r, 2), std, 7.5, False, 'left')
        set_cell(table.cell(r, 3), ctrl, 7.5, False, 'left')
        set_row_height(table.rows[r], 0.9)

    # 签字行
    r0 = 3 + len(content)
    merge_range(table, r0, 0, r0, ncols - 1)
    set_cell(table.cell(r0, 0), '检查人签字：', 8, False, 'left')
    set_row_height(table.rows[r0], 0.7)
    r1 = r0 + 1
    merge_range(table, r1, 0, r1, ncols - 1)
    set_cell(table.cell(r1, 0), '班组长复查：', 8, False, 'left')
    set_row_height(table.rows[r1], 0.7)

    # 隐患排查及处理记录区
    r2 = r1 + 1
    merge_range(table, r2, 0, r2, ncols - 1)
    set_cell(table.cell(r2, 0), '隐患排查及处理记录', 8, True, 'left')
    set_cell_bg(table.cell(r2, 0), 'D9D9D9')
    r3 = r2 + 1
    hdr = ['隐患叙述', '排查人', '处理过程', '是否当班治理完成', '复查人', '备注']
    col_spans = [max(1, int(n_rec * 0.35)), max(1, int(n_rec * 0.1)),
                 max(1, int(n_rec * 0.3)), max(1, int(n_rec * 0.1)),
                 max(1, int(n_rec * 0.1)), max(1, int(n_rec * 0.05))]
    # 调整为精确分配记录列
    used = 4
    spans = []
    for s in col_spans:
        if used + s > ncols:
            s = ncols - used
        spans.append(s)
        used += s
    c = 0
    for h, s in zip(hdr, spans):
        if s > 1:
            merge_range(table, r3, c, r3, c + s - 1)
        set_cell(table.cell(r3, c), h, 8, True)
        set_cell_bg(table.cell(r3, c), 'F2F2F2')
        c += s
    for k in range(4):
        rr = r3 + 1 + k
        for cc in range(ncols):
            set_cell(table.cell(rr, cc), '', 8)
        set_row_height(table.rows[rr], 0.6)
    return table


