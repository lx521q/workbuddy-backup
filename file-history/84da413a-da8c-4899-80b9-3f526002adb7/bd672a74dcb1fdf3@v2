def set_cell_border(cell, **kwargs):
    """设置单元格边框"""
    tc = cell._tc
    tcPr = tc.get_or_add_tcPr()
    tcBorders = OxmlElement('w:tcBorders')
    for edge in ('start', 'top', 'end', 'bottom', 'insideH', 'insideV'):
        if edge in kwargs:
            element = OxmlElement(f'w:{edge}')
            for attr in kwargs[edge]:
                element.set(qn(f'w:{attr}'), str(kwargs[edge][attr]))
            tcBorders.append(element)
    tcPr.append(tcBorders)

def set_cell_shading(cell, color):
    """设置单元格底色"""
    tc = cell._tc
    tcPr = tc.get_or_add_tcPr()
    shading = OxmlElement('w:shd')
    shading.set(qn('w:fill'), color)
    shading.set(qn('w:val'), 'clear')
    tcPr.append(shading)

def set_cell_vertical_alignment(cell, align='center'):
    """设置单元格垂直对齐"""
    tc = cell._tc
    tcPr = tc.get_or_add_tcPr()
    vAlign = OxmlElement('w:vAlign')
    vAlign.set(qn('w:val'), align)
    tcPr.append(vAlign)

def add_formatted_paragraph(cell, text, bold=False, font_size=10.5, alignment=WD_ALIGN_PARAGRAPH.LEFT, font_name='宋体'):
    """在单元格中添加格式化段落"""
    p = cell.paragraphs[0] if cell.paragraphs else cell.add_paragraph()
    p.alignment = alignment
    p.paragraph_format.space_before = Pt(2)
    p.paragraph_format.space_after = Pt(2)
    p.paragraph_format.line_spacing = Pt(18)
    run = p.add_run(text)
    run.font.size = Pt(font_size)
    run.font.name = font_name
    run._element.rPr.rFonts.set(qn('w:eastAsia'), font_name)
    run.bold = bold
    return p

def add_multi_paragraph(cell, texts, font_size=10.5):
    """在单元格中添加多段文字"""
    for i, text in enumerate(texts):
        if i == 0:
            p = cell.paragraphs[0]
            p.clear()
        else:
            p = cell.add_paragraph()
        p.paragraph_format.space_before = Pt(2)
        p.paragraph_format.space_after = Pt(2)
        p.paragraph_format.line_spacing = Pt(18)
        if isinstance(text, tuple):
            content, bold = text
        else:
            content, bold = text, False
        run = p.add_run(content)
        run.font.size = Pt(font_size)
        run.font.name = '宋体'
        run._element.rPr.rFonts.set(qn('w:eastAsia'), '宋体')
        run.bold = bold

