from docx import Document

doc = Document(r'D:\Lx电脑文件\J检修相关\2026.3检修安全作业方案\施工方案管理制度AQ001-2026.3.04\修改后施工方案\YXCJ-2026-015废油蒸馏8月技改、停车检修施工方案.docx')
table = doc.tables[0]
print(f'Table rows: {len(table.rows)}, cols: {len(table.rows[0].cells)}')
for r_idx, row in enumerate(table.rows):
    cells = row.cells
    cell_texts = []
    for c in cells:
        t = c.text.strip().replace('\n', '|')[:80]
        cell_texts.append(t)
    print(f'Row{r_idx} ({len(cells)} cells):')
    for ci, ct in enumerate(cell_texts):
        print(f'  Cell{ci}: {ct}')
