# 作业活动类管控清单列: 编号|类型|名称|步骤序号|步骤名称|危险源|评价级别|风险分级|事故类型|工程|管理|培训|个体|应急|层级|单位|责任人|备注
def jha_to_control(rows, risk_name, risk_type, unit, person):
    out = []
    for i, r in enumerate(rows, 1):
        act, step, hazard, accident, eng, mgmt, train, pp, emerg, L, S, R, level, tier = r
        out.append([i, risk_type, risk_name, i, step, hazard, R, level, accident,
                    eng, mgmt, train, pp, emerg, tier, unit, person, ''])
    return out

# 设备设施类管控清单列: 编号|类型|名称|设备名称|检查项目|标准|评价级别|风险分级|不符合后果|工程|管理|培训|个体|应急|层级|单位|责任人|备注
def scl_to_control(rows, risk_name, risk_type, unit, person):
    out = []
    for i, r in enumerate(rows, 1):
        equip, item, std, bad, eng, mgmt, train, pp, emerg, L, S, R, level, tier = r
        out.append([i, risk_type, risk_name, equip, item, std, R, level, bad,
                    eng, mgmt, train, pp, emerg, tier, unit, person, ''])
    return out


