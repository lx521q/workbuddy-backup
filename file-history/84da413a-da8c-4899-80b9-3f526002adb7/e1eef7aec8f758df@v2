import openpyxl
from collections import defaultdict

wb = openpyxl.load_workbook(r'C:\Users\62628\Downloads\2026.6-8.xlsx', data_only=True)
ws = wb['库存杂发单']

items = []
for r in range(3, ws.max_row + 1):
    date = ws.cell(r, 2).value
    doc_type = ws.cell(r, 3).value
    category = ws.cell(r, 4).value or ''
    name = ws.cell(r, 7).value or ''
    qty = ws.cell(r, 9).value or 0
    price = ws.cell(r, 10).value or 0
    amount = ws.cell(r, 11).value or 0

    if date is None:
        continue

    if hasattr(date, 'strftime'):
        month = date.strftime('%Y-%m')
        date_str = date.strftime('%Y-%m-%d')
    else:
        date_str = str(date)[:10]
        month = date_str[:7]

    items.append({
        'month': month,
        'date': date_str,
        'doc_type': doc_type or '',
        'category': category,
        'name': name,
        'qty': qty,
        'price': price,
        'amount': float(amount) if amount and str(amount).replace('.','').replace('-','').isdigit() else 0,
    })

print(f'总记录数: {len(items)}')
print()

# 1. By month
print('=== 按月汇总 ===')
month_data = defaultdict(lambda: {'count': 0, 'total': 0})
for it in items:
    month_data[it['month']]['count'] += 1
    month_data[it['month']]['total'] += it['amount']

for m in sorted(month_data.keys()):
    d = month_data[m]
    print(f'  {m}: {d["count"]}笔, 金额 {d["total"]:,.2f}元')

total_all = sum(d['total'] for d in month_data.values())
print(f'  合计: {len(items)}笔, 金额 {total_all:,.2f}元')

# 2. By category
print()
print('=== 按财务分类汇总 ===')
cat_data = defaultdict(lambda: {'count': 0, 'total': 0})
for it in items:
    cat_data[it['category']]['count'] += 1
    cat_data[it['category']]['total'] += it['amount']

for cat in sorted(cat_data.keys(), key=lambda x: -cat_data[x]['total']):
    d = cat_data[cat]
    pct = d['total'] / total_all * 100
    print(f'  {cat}: {d["count"]}笔, {d["total"]:,.2f}元 ({pct:.1f}%)')

# 3. Top 20 by amount
print()
print('=== 金额TOP20 ===')
sorted_items = sorted(items, key=lambda x: -x['amount'])
for i, it in enumerate(sorted_items[:20]):
    print(f'  {i+1}. [{it["date"]}] {it["name"][:30]} | {it["category"]} | {it["amount"]:,.2f}元')

# 4. By category x month
