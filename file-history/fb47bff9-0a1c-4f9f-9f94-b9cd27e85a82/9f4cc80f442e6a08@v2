                        "area_id": area_id, "identifiers": [[plat, did]],
                        "disabled_by": None, "via_device_id": None, "sw_version": "1.%d" % i})
        doms = ["light", "switch", "sensor", "binary_sensor", "cover", "climate"]
        for j in range(max(n, 1) if n else 1):
            eid = "%s.%s_%d" % (doms[j % len(doms)], did, j)
            entities.append({"entity_id": eid, "device_id": did, "platform": plat,
                             "area_id": None, "name": None, "original_name": "%s %d" % (name, j),
                             "disabled_by": None, "hidden_by": None, "entity_category": None})
            st = "on"
            if name == "旧空调伴侣(已换)":
                st = "unavailable"
            elif name == "晾衣架电机" and j < 2:
                st = "unavailable"
            elif name == "Yeelight 吸顶灯" and j == 0:
                st = "unavailable"
            states.append({"entity_id": eid, "state": st,
                           "attributes": {"friendly_name": "%s %d" % (name, j)},
                           "last_changed": "2026-10-31T00:%02d:00+08:00" % (i + j)})
    return {"areas": areas, "devices": devices, "entities": entities, "states": states,
            "config": {"version": "2025.10.1 (示例数据)"}}

# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(description="Home Assistant 设备台账生成器")
    ap.add_argument("--url")
    ap.add_argument("--token")
    ap.add_argument("--out")
    ap.add_argument("--mock", action="store_true", help="用示例数据自检输出格式")
    args = ap.parse_args()

    if args.mock:
        data = mock_data()
        print("使用示例数据自检（非真实设备）")
    else:
        env = load_env(os.path.join(os.path.dirname(os.path.abspath(__file__)), "ha.env"))
        base = args.url or os.environ.get("HA_URL") or env.get("HA_URL")
        token = args.token or os.environ.get("HA_TOKEN") or env.get("HA_TOKEN")
        if not base or not token:
            print("缺少 HA 地址或令牌。三种给法：\n"
                  "  1) 脚本同目录建 ha.env（HA_URL=... / HA_TOKEN=...）\n"
                  "  2) 命令行 --url --token\n"
                  "  3) 环境变量 HA_URL / HA_TOKEN\n"
                  "先用 --mock 看输出格式。")
            sys.exit(2)
        try:
            data = fetch(HA(base, token))
            json.dump({"config": data["config"],
                       "areas": data["areas"], "devices": data["devices"],
                       "entities": data["entities"]},
                      open(os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                        "ha_raw_snapshot.json"), "w", encoding="utf-8"),
                      ensure_ascii=False, indent=1)
        except HTTPError as e:
            print("HA 返回 %s：%s" % (e.code, "令牌无效或无权限" if e.code == 401 else e.reason))
            sys.exit(1)
        except (URLError, OSError) as e:
            print("连不上 %s（%s）。确认：本机与 HA 在同一局域网？HA 在运行？端口 8123 开放？"
                  % (base, e))
            sys.exit(1)

    devices_rows, ent_rows, issues, summary = build(data)
    out = args.out or ("设备台账_%s%s.xlsx" % (datetime.now().strftime("%Y%m%d"),
                                              "_示例" if args.mock else ""))
    out = os.path.join(os.path.dirname(os.path.abspath(__file__)), os.path.basename(out))
    export(devices_rows, ent_rows, issues, summary, out)
    print("\n已生成：%s" % out)
    print("设备 %d 台，其中异常 %d 台；待处理问题 %d 条"
          % (summary["devices"], summary["problem_dev"], summary["issues"]))
    for it in issues[:12]:
        print("  - [%s] %s" % (it[0], it[1]))


if __name__ == "__main__":
    main()
