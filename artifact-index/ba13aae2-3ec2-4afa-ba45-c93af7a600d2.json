{"version":1,"lastUpdated":1794033650772,"artifacts":[{"type":"media","uri":"file:///C:/Users/62628/WorkBuddy/2026-10-25-16-02-55/%E6%B4%9E%E6%B4%9E%E6%9D%BF%E5%AE%89%E8%A3%85%E5%9B%BE-2000x1200.html","name":"洞洞板安装图-2000x1200.html","title":"洞洞板安装图-2000x1200.html","mimeType":"text/html","contentType":"code","size":9217,"createdAt":1793923611288,"updatedAt":1793923611289.9336,"_meta":{"sourceTool":"PresentFiles","requestId":"01a1ae2c4a927bd685a826f186febefe"}},{"type":"file-changes","uri":"file-changes://C%3A%5CUsers%5C62628%5CWorkBuddy%5C2026-10-25-16-02-55%5C%E6%B4%9E%E6%B4%9E%E6%9D%BF%E5%AE%89%E8%A3%85%E5%9B%BE-2000x1200.html","name":"洞洞板安装图-2000x1200.html","title":"洞洞板安装图-2000x1200.html","mimeType":"text/x-diff","contentType":"diff","fileChangeInfo":{"uri":"C:\\Users\\62628\\WorkBuddy\\2026-10-25-16-02-55\\洞洞板安装图-2000x1200.html","changeType":"modified","additions":129,"deletions":0,"diff":"Index: C:\\Users\\62628\\WorkBuddy\\2026-10-25-16-02-55\\洞洞板安装图-2000x1200.html\n===================================================================\n--- C:\\Users\\62628\\WorkBuddy\\2026-10-25-16-02-55\\洞洞板安装图-2000x1200.html\n+++ C:\\Users\\62628\\WorkBuddy\\2026-10-25-16-02-55\\洞洞板安装图-2000x1200.html\n@@ -0,0 +1,129 @@\n+<!DOCTYPE html>\n+<html lang=\"zh-CN\">\n+<head>\n+<meta charset=\"UTF-8\">\n+<title>2000×1200 洞洞板安装图</title>\n+<style>\n+  body { font-family: \"Microsoft YaHei\", sans-serif; color:#2C2C2A; max-width: 760px; margin: 0 auto; padding: 24px 16px; }\n+  h1 { font-size: 20px; font-weight: 600; }\n+  h2 { font-size: 16px; font-weight: 600; margin-top: 28px; }\n+  .meta { color:#5F5E5A; font-size: 13px; }\n+  table { border-collapse: collapse; width: 100%; font-size: 13px; margin: 8px 0; }\n+  th, td { border: 1px solid #D3D1C7; padding: 6px 8px; text-align: left; }\n+  th { background: #F1EFE8; }\n+  .note { background:#FAEEDA; border-left: 4px solid #EF9F27; padding: 8px 12px; font-size: 13px; margin: 12px 0; }\n+  ol li, ul li { font-size: 13px; line-height: 1.7; }\n+  svg { max-width: 100%; height: auto; display:block; margin: 8px 0; }\n+</style>\n+</head>\n+<body>\n+\n+<h1>2000 × 1200 洞洞板安装图</h1>\n+<p class=\"meta\">墙面 2600 × 2800 · 居中安装，两侧各留 300 · 底边离地 650，顶边 1850（舒适区内）</p>\n+\n+<h2>一、正视图（挂件分区 + 固定点位）</h2>\n+<svg viewBox=\"0 0 720 400\" xmlns=\"http://www.w3.org/2000/svg\">\n+  <defs>\n+    <marker id=\"a\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\">\n+      <path d=\"M2 1L8 5L2 9\" fill=\"none\" stroke=\"context-stroke\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n+    </marker>\n+  </defs>\n+  <!-- 墙体 -->\n+  <rect x=\"150\" y=\"50\" width=\"260\" height=\"280\" fill=\"#F1EFE8\" stroke=\"#B4B2A9\" stroke-width=\"0.5\"/>\n+  <line x1=\"150\" y1=\"50\" x2=\"410\" y2=\"50\" stroke=\"#5F5E5A\" stroke-width=\"1.5\"/>\n+  <line x1=\"150\" y1=\"330\" x2=\"410\" y2=\"330\" stroke=\"#5F5E5A\" stroke-width=\"1.5\"/>\n+  <text x=\"155\" y=\"42\" font-size=\"11\" fill=\"#5F5E5A\">天花 2800</text>\n+  <text x=\"405\" y=\"345\" font-size=\"11\" fill=\"#5F5E5A\" text-anchor=\"end\">地面</text>\n+  <!-- 板分区 -->\n+  <rect x=\"180\" y=\"145\" width=\"50\" height=\"120\" fill=\"#E1F5EE\" stroke=\"#185FA5\" stroke-width=\"0.5\"/>\n+  <rect x=\"230\" y=\"145\" width=\"50\" height=\"120\" fill=\"#E6F1FB\" stroke=\"#185FA5\" stroke-width=\"0.5\"/>\n+  <rect x=\"280\" y=\"145\" width=\"50\" height=\"120\" fill=\"#FAEEDA\" stroke=\"#185FA5\" stroke-width=\"0.5\"/>\n+  <rect x=\"330\" y=\"145\" width=\"50\" height=\"120\" fill=\"#FCEBEB\" stroke=\"#185FA5\" stroke-width=\"0.5\"/>\n+  <!-- 龙骨虚线 -->\n+  <line x1=\"180\" y1=\"258\" x2=\"380\" y2=\"258\" stroke=\"#993C1D\" stroke-width=\"1\" stroke-dasharray=\"5 3\"/>\n+  <line x1=\"180\" y1=\"205\" x2=\"380\" y2=\"205\" stroke=\"#993C1D\" stroke-width=\"1\" stroke-dasharray=\"5 3\"/>\n+  <line x1=\"180\" y1=\"152\" x2=\"380\" y2=\"152\" stroke=\"#993C1D\" stroke-width=\"1\" stroke-dasharray=\"5 3\"/>\n+  <!-- 螺栓点 -->\n+  <g fill=\"#993C1D\">\n+    <circle cx=\"185\" cy=\"258\" r=\"2.5\"/><circle cx=\"232\" cy=\"258\" r=\"2.5\"/><circle cx=\"280\" cy=\"258\" r=\"2.5\"/><circle cx=\"327\" cy=\"258\" r=\"2.5\"/><circle cx=\"375\" cy=\"258\" r=\"2.5\"/>\n+    <circle cx=\"185\" cy=\"205\" r=\"2.5\"/><circle cx=\"232\" cy=\"205\" r=\"2.5\"/><circle cx=\"280\" cy=\"205\" r=\"2.5\"/><circle cx=\"327\" cy=\"205\" r=\"2.5\"/><circle cx=\"375\" cy=\"205\" r=\"2.5\"/>\n+    <circle cx=\"185\" cy=\"152\" r=\"2.5\"/><circle cx=\"232\" cy=\"152\" r=\"2.5\"/><circle cx=\"280\" cy=\"152\" r=\"2.5\"/><circle cx=\"327\" cy=\"152\" r=\"2.5\"/><circle cx=\"375\" cy=\"152\" r=\"2.5\"/>\n+  </g>\n+  <!-- 尺寸 -->\n+  <line x1=\"180\" y1=\"350\" x2=\"380\" y2=\"350\" stroke=\"#185FA5\" stroke-width=\"1\" marker-start=\"url(#a)\" marker-end=\"url(#a)\"/>\n+  <text x=\"280\" y=\"364\" text-anchor=\"middle\" font-size=\"11\" fill=\"#185FA5\">2000</text>\n+  <line x1=\"150\" y1=\"350\" x2=\"180\" y2=\"350\" stroke=\"#B4B2A9\" stroke-width=\"1\"/>\n+  <text x=\"165\" y=\"364\" text-anchor=\"middle\" font-size=\"11\" fill=\"#5F5E5A\">300</text>\n+  <line x1=\"380\" y1=\"350\" x2=\"410\" y2=\"350\" stroke=\"#B4B2A9\" stroke-width=\"1\"/>\n+  <text x=\"395\" y=\"364\" text-anchor=\"middle\" font-size=\"11\" fill=\"#5F5E5A\">300</text>\n+  <line x1=\"425\" y1=\"145\" x2=\"425\" y2=\"265\" stroke=\"#185FA5\" stroke-width=\"1\" marker-start=\"url(#a)\" marker-end=\"url(#a)\"/>\n+  <line x1=\"380\" y1=\"145\" x2=\"432\" y2=\"145\" stroke=\"#B4B2A9\" stroke-width=\"0.5\" stroke-dasharray=\"3 2\"/>\n+  <line x1=\"380\" y1=\"265\" x2=\"432\" y2=\"265\" stroke=\"#B4B2A9\" stroke-width=\"0.5\" stroke-dasharray=\"3 2\"/>\n+  <text x=\"432\" y=\"205\" font-size=\"11\" fill=\"#185FA5\" dominant-baseline=\"central\">1200</text>\n+  <line x1=\"425\" y1=\"265\" x2=\"425\" y2=\"330\" stroke=\"#5F5E5A\" stroke-width=\"1\" marker-start=\"url(#a)\" marker-end=\"url(#a)\"/>\n+  <line x1=\"380\" y1=\"330\" x2=\"432\" y2=\"330\" stroke=\"#B4B2A9\" stroke-width=\"0.5\" stroke-dasharray=\"3 2\"/>\n+  <text x=\"432\" y=\"297\" font-size=\"11\" fill=\"#5F5E5A\" dominant-baseline=\"central\">650</text>\n+  <text x=\"280\" y=\"120\" text-anchor=\"middle\" font-size=\"12\" fill=\"#042C53\">洞洞板 2000 × 1200（红线 = 横向龙骨 3 道，圆点 = 膨胀螺栓）</text>\n+</svg>\n+<p style=\"font-size:13px\">\n+<b>龙骨中心线高度：</b>700 / 1250 / 1800（各距板边 50mm）。<b>每道 5 个固定点</b>，距板左边缘 50 / 550 / 1050 / 1550 / 1950，共 15 点。<br>\n+<b>分区（从左到右）：</b>\n+<span style=\"background:#E1F5EE\">■</span> 动力工具区（电钻、角磨机，重物放底部）\n+<span style=\"background:#E6F1FB\">■</span> 扳手/套筒区（视线带 1150–1650）\n+<span style=\"background:#FAEEDA\">■</span> 手工具区（螺丝刀、钳、锉）\n+<span style=\"background:#FCEBEB\">■</span> 零件收纳区（零件盒、挂篮、手套）\n+</p>\n+\n+<h2>二、侧剖面（防潮做法）</h2>\n+<svg viewBox=\"0 0 720 190\" xmlns=\"http://www.w3.org/2000/svg\">\n+  <defs>\n+    <marker id=\"b\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\">\n+      <path d=\"M2 1L8 5L2 9\" fill=\"none\" stroke=\"context-stroke\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n+    </marker>\n+  </defs>\n+  <rect x=\"420\" y=\"20\" width=\"60\" height=\"150\" fill=\"#D3D1C7\" stroke=\"#888780\" stroke-width=\"0.5\"/>\n+  <line x1=\"420\" y1=\"35\" x2=\"480\" y2=\"35\" stroke=\"#888780\" stroke-width=\"0.5\"/>\n+  <line x1=\"420\" y1=\"65\" x2=\"480\" y2=\"65\" stroke=\"#888780\" stroke-width=\"0.5\"/>\n+  <line x1=\"420\" y1=\"95\" x2=\"480\" y2=\"95\" stroke=\"#888780\" stroke-width=\"0.5\"/>\n+  <line x1=\"420\" y1=\"125\" x2=\"480\" y2=\"125\" stroke=\"#888780\" stroke-width=\"0.5\"/>\n+  <line x1=\"420\" y1=\"155\" x2=\"480\" y2=\"155\" stroke=\"#888780\" stroke-width=\"0.5\"/>\n+  <text x=\"450\" y=\"178\" text-anchor=\"middle\" font-size=\"12\" fill=\"#444441\">墙体</text>\n+  <rect x=\"404\" y=\"20\" width=\"16\" height=\"150\" fill=\"#993C1D\" opacity=\"0.75\"/>\n+  <text x=\"412\" y=\"178\" text-anchor=\"middle\" font-size=\"11\" fill=\"#993C1D\">龙骨</text>\n+  <rect x=\"396\" y=\"20\" width=\"8\" height=\"150\" fill=\"#185FA5\"/>\n+  <text x=\"400\" y=\"12\" text-anchor=\"middle\" font-size=\"12\" fill=\"#042C53\">洞洞板</text>\n+  <line x1=\"396\" y1=\"80\" x2=\"330\" y2=\"80\" stroke=\"#444441\" stroke-width=\"2\"/>\n+  <path d=\"M330 80 l-14 -10 l0 20 z\" fill=\"#444441\"/>\n+  <text x=\"300\" y=\"70\" text-anchor=\"end\" font-size=\"12\" fill=\"#444441\">挂钩 + 工具（挂在房间侧）</text>\n+  <line x1=\"412\" y1=\"40\" x2=\"560\" y2=\"40\" stroke=\"#993C1D\" stroke-width=\"0.8\" stroke-dasharray=\"3 2\" marker-end=\"url(#b)\"/>\n+  <text x=\"566\" y=\"44\" font-size=\"12\" fill=\"#993C1D\">膨胀螺栓 M8 穿板入墙</text>\n+  <line x1=\"404\" y1=\"120\" x2=\"560\" y2=\"120\" stroke=\"#5F5E5A\" stroke-width=\"0.8\" stroke-dasharray=\"3 2\" marker-start=\"url(#b)\" marker-end=\"url(#b)\"/>\n+  <text x=\"566\" y=\"124\" font-size=\"12\" fill=\"#5F5E5A\">板背离墙 30（龙骨厚度，兼通风防潮）</text>\n+</svg>\n+\n+<h2>三、材料清单</h2>\n+<table>\n+  <tr><th>项目</th><th>规格 / 数量</th><th>说明</th></tr>\n+  <tr><td>洞洞板</td><td>2000 × 1200 × 1</td><td>地下室选镀锌钢板喷涂或防水多层板，勿用密度板</td></tr>\n+  <tr><td>横向龙骨</td><td>30 × 40 木龙骨 × 3 根（各 2m）</td><td>刷防腐漆两遍；代替方案 40×40 角钢</td></tr>\n+  <tr><td>膨胀螺栓</td><td>M8 × 80 × 15 颗</td><td>实心墙用铁胀栓；空心砖改化学锚栓或对穿螺杆</td></tr>\n+  <tr><td>自攻螺丝</td><td>4 × 30 × 15 颗</td><td>板面沉头，别凸出挂件面</td></tr>\n+  <tr><td>挂件</td><td>孔距 25mm 系列</td><td>挂钩、层板托、零件盒、挂篮按分区配</td></tr>\n+</table>\n+\n+<h2>四、安装步骤</h2>\n+<ol>\n+  <li><b>放线定位：</b>按底边离地 650 弹水平线（用水准仪，别信地面——地下室地面未必平）；板左右位置居中，即距两侧墙角各 300。</li>\n+  <li><b>找实体点：</b>探测墙内龙骨或砌块实体位置，微调 15 个螺栓点位；空心砖位置必须落在实体处或改用化学锚栓。</li>\n+  <li><b>固定龙骨：</b>3 道横向龙骨按 700 / 1250 / 1800 高度固定，同一道龙骨要水平（误差 ≤2mm），这是板面平不平的关键。</li>\n+  <li><b>上板：</b>两人抬板上墙对孔，先拧四角、再拧中间，逐点紧固；全程检查板面水平。</li>\n+  <li><b>装挂件：</b>按分区布置，重的（电钻、工具箱）挂在每道龙骨高度附近，别挂在两道龙骨之间的板面悬空处。</li>\n+  <li><b>验收：</b>挂最重工具 24 小时后复紧一遍螺丝，检查板面有无变形、缝有无开裂。</li>\n+</ol>\n+\n+<div class=\"note\">\n+<b>地下室两条红线：</b>① 板背离墙 30mm 的空隙不能封死，留作通风防潮；② 墙面若有返潮、结露，先做防水或涂装处理再上板，否则板后墙皮会霉。\n+</div>\n+\n+</body>\n+</html>\n"},"createdAt":1794033650770,"updatedAt":1794033650770}]}