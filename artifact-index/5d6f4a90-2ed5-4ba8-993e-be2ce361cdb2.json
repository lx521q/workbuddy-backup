{"version":1,"lastUpdated":1786160983264,"artifacts":[{"type":"media","uri":"file:///C:/Users/62628/WorkBuddy/2026-08-08-10-50-39/%E5%AD%99%E5%A8%84%E4%B8%9C%E6%9D%91%E6%99%BA%E8%83%BD%E5%AE%B6%E5%B1%85%E9%A1%B9%E7%9B%AE%E6%96%B9%E6%A1%88.html","name":"孙娄东村智能家居项目方案.html","title":"孙娄东村智能家居项目方案.html","mimeType":"text/html","contentType":"code","size":26956,"createdAt":1786157600329,"updatedAt":1786157600334,"_meta":{"sourceTool":"PresentFiles","requestId":"0fd796a3305347d09642cf7f501b65e1"}},{"type":"media","uri":"file:///C:/Users/62628/WorkBuddy/2026-08-08-10-50-39/%E5%AD%99%E5%A8%84%E4%B8%9C%E6%9D%91%E6%99%BA%E8%83%BD%E5%AE%B6%E5%B1%85%E9%A1%B9%E7%9B%AE%E6%96%B9%E6%A1%88.pdf","name":"孙娄东村智能家居项目方案.pdf","title":"孙娄东村智能家居项目方案.pdf","mimeType":"application/pdf","contentType":"document","size":1534723,"createdAt":1786158215775,"updatedAt":1786158215776,"_meta":{"sourceTool":"PresentFiles","requestId":"ae981e6b3d674ffab3e3f184a932c856"}},{"type":"file-changes","uri":"file-changes://C%3A%5CUsers%5C62628%5CWorkBuddy%5C2026-08-08-10-50-39%5C%E5%AD%99%E5%A8%84%E4%B8%9C%E6%9D%91%E6%99%BA%E8%83%BD%E5%AE%B6%E5%B1%85%E9%A1%B9%E7%9B%AE%E6%96%B9%E6%A1%88.html","name":"孙娄东村智能家居项目方案.html","title":"孙娄东村智能家居项目方案.html","mimeType":"text/x-diff","contentType":"diff","fileChangeInfo":{"uri":"C:\\Users\\62628\\WorkBuddy\\2026-08-08-10-50-39\\孙娄东村智能家居项目方案.html","changeType":"modified","additions":474,"deletions":0,"diff":"Index: C:\\Users\\62628\\WorkBuddy\\2026-08-08-10-50-39\\孙娄东村智能家居项目方案.html\n===================================================================\n--- C:\\Users\\62628\\WorkBuddy\\2026-08-08-10-50-39\\孙娄东村智能家居项目方案.html\n+++ C:\\Users\\62628\\WorkBuddy\\2026-08-08-10-50-39\\孙娄东村智能家居项目方案.html\n@@ -0,0 +1,474 @@\n+<!DOCTYPE html>\n+<html lang=\"zh-CN\">\n+<head>\n+<meta charset=\"UTF-8\">\n+<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+<title>孙娄东村二期 - 集装箱智能家居体验店商业计划</title>\n+<style>\n+  :root {\n+    --bg: #f5f5f5;\n+    --card-bg: #ffffff;\n+    --text: #222;\n+    --sub: #555;\n+    --accent: #e8590c;\n+    --accent2: #1971c2;\n+    --green: #2b8a3e;\n+    --red: #c92a2a;\n+    --border: #dee2e6;\n+    --tag-bg: #fff4e6;\n+    --table-stripe: #f8f9fa;\n+  }\n+  * { margin:0; padding:0; box-sizing:border-box; }\n+  body { font-family: \"PingFang SC\",\"Microsoft YaHei\",\"Hiragino Sans GB\",sans-serif; background:var(--bg); color:var(--text); line-height:1.7; }\n+  .container { max-width:960px; margin:0 auto; padding:24px 20px 60px; }\n+\n+  /* Hero */\n+  .hero { background:linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); color:#fff; border-radius:12px; padding:40px 36px; margin-bottom:28px; position:relative; overflow:hidden; }\n+  .hero::after { content:''; position:absolute; right:-40px; top:-40px; width:200px; height:200px; background:rgba(255,255,255,0.03); border-radius:50%; }\n+  .hero h1 { font-size:2em; margin-bottom:8px; letter-spacing:1px; }\n+  .hero .subtitle { font-size:1.05em; opacity:0.85; margin-bottom:16px; }\n+  .hero .badges { display:flex; gap:10px; flex-wrap:wrap; }\n+  .hero .badge { background:rgba(255,255,255,0.15); border:1px solid rgba(255,255,255,0.25); padding:5px 14px; border-radius:20px; font-size:0.85em; }\n+\n+  /* Sections */\n+  .section { background:var(--card-bg); border-radius:10px; padding:28px 32px; margin-bottom:20px; box-shadow:0 1px 4px rgba(0,0,0,0.06); }\n+  .section h2 { font-size:1.35em; color:var(--accent); margin-bottom:16px; padding-bottom:10px; border-bottom:2px solid var(--accent); display:flex; align-items:center; gap:10px; }\n+  .section h2 .num { background:var(--accent); color:#fff; width:30px; height:30px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:0.85em; flex-shrink:0; }\n+  .section h3 { font-size:1.1em; margin:18px 0 10px; color:#333; }\n+\n+  /* Tables */\n+  table { width:100%; border-collapse:collapse; margin:12px 0; font-size:0.93em; }\n+  th { background:#f1f3f5; padding:10px 12px; text-align:left; font-weight:600; border:1px solid var(--border); }\n+  td { padding:9px 12px; border:1px solid var(--border); }\n+  tr:nth-child(even) td { background:var(--table-stripe); }\n+  .num-cell { text-align:right; font-variant-numeric:tabular-nums; }\n+\n+  /* KPI cards */\n+  .kpi-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:14px; margin:16px 0; }\n+  .kpi-card { background:var(--tag-bg); border:1px solid var(--border); border-radius:8px; padding:16px; text-align:center; }\n+  .kpi-card .value { font-size:1.6em; font-weight:700; color:var(--accent); }\n+  .kpi-card .label { font-size:0.85em; color:var(--sub); margin-top:4px; }\n+\n+  /* Tags */\n+  .tag { display:inline-block; background:#e7f5ff; color:var(--accent2); padding:3px 10px; border-radius:4px; font-size:0.82em; margin:2px 4px 2px 0; }\n+  .tag.warn { background:#fff3cd; color:#856404; }\n+  .tag.green { background:#d3f9d8; color:var(--green); }\n+  .tag.red { background:#ffe3e3; color:var(--red); }\n+\n+  /* Highlights */\n+  .highlight { background:#fff9db; border-left:4px solid #fcc419; padding:12px 16px; margin:12px 0; border-radius:0 6px 6px 0; font-size:0.93em; }\n+  .highlight strong { color:var(--accent); }\n+\n+  /* Flow */\n+  .flow { display:flex; align-items:center; justify-content:center; gap:8px; flex-wrap:wrap; margin:16px 0; font-size:0.9em; }\n+  .flow .step { background:var(--accent); color:#fff; padding:8px 16px; border-radius:20px; white-space:nowrap; }\n+  .flow .arrow { color:var(--accent); font-size:1.3em; }\n+\n+  /* Responsive */\n+  @media (max-width:640px) {\n+    .hero { padding:28px 20px; }\n+    .hero h1 { font-size:1.5em; }\n+    .section { padding:20px 18px; }\n+    .kpi-grid { grid-template-columns:1fr 1fr; }\n+  }\n+\n+  .footer { text-align:center; color:#999; font-size:0.82em; margin-top:32px; }\n+  .footer a { color:var(--accent2); }\n+</style>\n+</head>\n+<body>\n+<div class=\"container\">\n+\n+<!-- ====== HERO ====== -->\n+<div class=\"hero\">\n+  <h1>孙娄东村二期 · 集装箱智能家居体验店</h1>\n+  <div class=\"subtitle\">商业计划书 | 2026年8月</div>\n+  <div class=\"badges\">\n+    <span class=\"badge\">710户目标市场</span>\n+    <span class=\"badge\">钥匙发放窗口期</span>\n+    <span class=\"badge\">智能马桶 + 全屋智能</span>\n+    <span class=\"badge\">可拆卸集装箱展厅</span>\n+  </div>\n+</div>\n+\n+<!-- ====== 第一章：项目背景 ====== -->\n+<div class=\"section\">\n+  <h2><span class=\"num\">1</span> 项目背景与市场分析</h2>\n+  \n+  <h3>1.1 孙娄东村二期项目概况</h3>\n+  <table>\n+    <tr><th style=\"width:140px\">项目</th><th>详情</th></tr>\n+    <tr><td>项目名称</td><td>临淄区稷下街道孙娄新村二期（棚户区改造）</td></tr>\n+    <tr><td>建设规模</td><td>8栋住宅楼（3#-6#、11#、12#、16#、17#），22-24层</td></tr>\n+    <tr><td>总建筑面积</td><td>约14.28万㎡（含地下车库约4.1万㎡）</td></tr>\n+    <tr><td>安置户数</td><td><strong>710户</strong></td></tr>\n+    <tr><td>开工/竣工</td><td>2020年6月开工 / 2022年6月竣工</td></tr>\n+    <tr><td>当前状态</td><td><span class=\"tag green\">2026年8月结算，发放钥匙</span></td></tr>\n+    <tr><td>项目性质</td><td>城中村改造回迁安置房</td></tr>\n+    <tr><td>建设主体</td><td>孙娄东村村民委员会（自筹资金）</td></tr>\n+  </table>\n+\n+  <h3>1.2 为什么这是一个好机会？</h3>\n+  <div class=\"kpi-grid\">\n+    <div class=\"kpi-card\"><div class=\"value\">710户</div><div class=\"label\">待装修新房</div></div>\n+    <div class=\"kpi-card\"><div class=\"value\">零竞争</div><div class=\"label\">周边无智能家居门店</div></div>\n+    <div class=\"kpi-card\"><div class=\"value\">钥匙期</div><div class=\"label\">装修决策黄金窗口</div></div>\n+    <div class=\"kpi-card\"><div class=\"value\">熟人社区</div><div class=\"label\">口碑传播效率极高</div></div>\n+  </div>\n+\n+  <div class=\"highlight\">\n+    <strong>核心判断：</strong>710户居民集中拿到钥匙，接下来1-3个月是装修决策的高峰期。在这个时间窗口内，在小区门口用集装箱搭建一个\"看得见、摸得着、能体验\"的实景展厅，可以最大化截获装修需求——尤其是智能马桶（每户必装）和智能家居（差异化升级）。\n+  </div>\n+\n+  <h3>1.3 目标客群画像</h3>\n+  <table>\n+    <tr><th>维度</th><th>特征</th></tr>\n+    <tr><td>身份</td><td>回迁村民，部分三代同堂</td></tr>\n+    <tr><td>消费力</td><td>中档偏上——回迁户通常有拆迁补偿，装修预算充足</td></tr>\n+    <tr><td>信息渠道</td><td>熟人推荐、微信群、线下实体店</td></tr>\n+    <tr><td>决策特征</td><td>看重实物体验、在意邻里口碑、对价格敏感但愿意为好东西付费</td></tr>\n+    <tr><td>痛点</td><td>对智能马桶不了解、不知道去哪买、担心安装售后</td></tr>\n+  </table>\n+</div>\n+\n+<!-- ====== 第二章：集装箱展厅方案 ====== -->\n+<div class=\"section\">\n+  <h2><span class=\"num\">2</span> 集装箱展厅设计方案</h2>\n+\n+  <h3>2.1 集装箱选型</h3>\n+  <table>\n+    <tr><th>方案</th><th>规格</th><th>面积</th><th>租金</th><th>月成本</th><th>推荐</th></tr>\n+    <tr>\n+      <td><strong>A 方案（推荐）</strong></td>\n+      <td>3m × 6m × 2.6m<br>标准住人集装箱</td>\n+      <td>18㎡</td>\n+      <td>6元/天</td>\n+      <td>≈180元/月</td>\n+      <td><span class=\"tag green\">★ 首选</span></td>\n+    </tr>\n+    <tr>\n+      <td>B 方案</td>\n+      <td>同规格 + 空调</td>\n+      <td>18㎡</td>\n+      <td>10元/天</td>\n+      <td>≈300元/月</td>\n+      <td><span class=\"tag\">备选</span></td>\n+    </tr>\n+    <tr>\n+      <td>C 方案（购买）</td>\n+      <td>直接购买</td>\n+      <td>18㎡</td>\n+      <td>—</td>\n+      <td>约4,500-5,000元/个</td>\n+      <td><span class=\"tag\">长线考虑</span></td>\n+    </tr>\n+  </table>\n+  <div class=\"highlight\">\n+    <strong>推荐 A 方案：</strong>先租1个集装箱（押金约5,000元，月租约180元），淄博本地有多家供应商。如果效果好，后续可以扩展到2-3个集装箱连通使用。\n+  </div>\n+\n+  <h3>2.2 内部布局设计</h3>\n+  <table>\n+    <tr><th style=\"width:100px\">区域</th><th>面积</th><th>内容</th></tr>\n+    <tr><td><strong>A区：智能马桶体验区</strong></td><td>约8㎡</td><td>2台智能马桶（入门级+中高端各一台），均通水通电可实际演示。设置隔断帘保证体验隐私。</td></tr>\n+    <tr><td><strong>B区：智能家居体验区</strong></td><td>约6㎡</td><td>智能门锁展示墙、智能开关面板、智能窗帘导轨（1米演示）、小爱/天猫精灵语音控制演示。</td></tr>\n+    <tr><td><strong>C区：接待洽谈区</strong></td><td>约4㎡</td><td>小桌+2椅、产品图册、报价单、预约登记表。</td></tr>\n+  </table>\n+\n+  <h3>2.3 水电配置</h3>\n+  <table>\n+    <tr><th>项目</th><th>方案</th><th>预算</th></tr>\n+    <tr><td>供电</td><td>从小区临时施工用电或附近商户接电，3-4KW足够</td><td>约500-1,000元（含线缆）</td></tr>\n+    <tr><td>给水</td><td>外接水管或使用储水桶+增压泵方案（马桶演示用水量很小）</td><td>约300-500元</td></tr>\n+    <tr><td>排水</td><td>临时排污管接入附近污水井，或用收集桶定期清理</td><td>约200-300元</td></tr>\n+    <tr><td>照明/空调</td><td>LED灯带 + 移动空调或风扇</td><td>约800-1,200元</td></tr>\n+    <tr><td>装修内饰</td><td>地面铺仿木地板贴、墙面刷白或贴墙纸、简易吊顶</td><td>约1,500-2,500元</td></tr>\n+    <tr><td><strong>合计</strong></td><td></td><td><strong>约3,300-5,500元</strong></td></tr>\n+  </table>\n+\n+  <h3>2.4 选址建议</h3>\n+  <div class=\"highlight\">\n+    <strong>最佳位置：</strong>孙娄东村二期小区主入口附近或钥匙发放点旁。与村委会或物业沟通，争取免费或低价场地（因为是服务本村居民）。若需付费，小区门口空地月租预计500-2,000元。\n+  </div>\n+</div>\n+\n+<!-- ====== 第三章：产品选型 ====== -->\n+<div class=\"section\">\n+  <h2><span class=\"num\">3</span> 产品选型与定价策略</h2>\n+\n+  <h3>3.1 智能马桶产品线（核心利润品）</h3>\n+  <table>\n+    <tr><th>档次</th><th>推荐型号</th><th>进价（估）</th><th>零售价</th><th>单台毛利</th><th>定位</th></tr>\n+    <tr>\n+      <td><span class=\"tag green\">入门</span></td>\n+      <td>惠达 Z990Max<br>（零水压、泡沫盾、脚感翻盖）</td>\n+      <td class=\"num-cell\">¥1,100</td>\n+      <td class=\"num-cell\">¥1,699</td>\n+      <td class=\"num-cell\" style=\"color:var(--red)\">¥599</td>\n+      <td>走量款，适合预算敏感家庭</td>\n+    </tr>\n+    <tr>\n+      <td><span class=\"tag\">中端</span></td>\n+      <td>九牧 ZS360X<br>（即热式、全功能、品牌认知度高）</td>\n+      <td class=\"num-cell\">¥1,400</td>\n+      <td class=\"num-cell\">¥2,199</td>\n+      <td class=\"num-cell\" style=\"color:var(--red)\">¥799</td>\n+      <td>利润主力，九牧品牌背书</td>\n+    </tr>\n+    <tr>\n+      <td><span class=\"tag\">中高端</span></td>\n+      <td>恒洁 H35 Pro<br>（低水压克星、UV除菌、6年质保）</td>\n+      <td class=\"num-cell\">¥2,200</td>\n+      <td class=\"num-cell\">¥3,299</td>\n+      <td class=\"num-cell\" style=\"color:var(--red)\">¥1,099</td>\n+      <td>高利润款，质保长有说服力</td>\n+    </tr>\n+    <tr>\n+      <td><span class=\"tag warn\">高端</span></td>\n+      <td>箭牌 AKE1119<br>（红点设计奖、鸿蒙智联）</td>\n+      <td class=\"num-cell\">¥2,600</td>\n+      <td class=\"num-cell\">¥3,999</td>\n+      <td class=\"num-cell\" style=\"color:var(--red)\">¥1,399</td>\n+      <td>形象款，提升展厅档次</td>\n+    </tr>\n+  </table>\n+  <div class=\"highlight\">\n+    <strong>进货策略：</strong>初期展厅各摆一台样机（共4台，成本约¥7,300）。客户下单后从代理商/厂家发货，无需大量压货。联系九牧、恒洁的山东区域代理谈代销或样品价。\n+  </div>\n+\n+  <h3>3.2 智能家居产品线（搭配销售）</h3>\n+  <table>\n+    <tr><th>品类</th><th>推荐产品</th><th>进价（估）</th><th>零售价</th><th>单套毛利</th></tr>\n+    <tr><td>智能门锁</td><td>小米/德施曼 3D人脸识别款</td><td class=\"num-cell\">¥800</td><td class=\"num-cell\">¥1,299</td><td class=\"num-cell\">¥499</td></tr>\n+    <tr><td>智能开关</td><td>Aqara/小米 Zigbee 三开面板 ×3</td><td class=\"num-cell\">¥240</td><td class=\"num-cell\">¥399</td><td class=\"num-cell\">¥159</td></tr>\n+    <tr><td>智能窗帘</td><td>Aqara 窗帘电机+导轨（3米）</td><td class=\"num-cell\">¥550</td><td class=\"num-cell\">¥899</td><td class=\"num-cell\">¥349</td></tr>\n+    <tr><td>智能灯</td><td>Yeelight 智能吸顶灯 ×3</td><td class=\"num-cell\">¥360</td><td class=\"num-cell\">¥599</td><td class=\"num-cell\">¥239</td></tr>\n+    <tr><td>语音中枢</td><td>小爱音箱 Pro / 天猫精灵</td><td class=\"num-cell\">¥200</td><td class=\"num-cell\">¥299</td><td class=\"num-cell\">¥99</td></tr>\n+    <tr><td>传感器</td><td>人体传感器+门窗传感器套装</td><td class=\"num-cell\">¥100</td><td class=\"num-cell\">¥199</td><td class=\"num-cell\">¥99</td></tr>\n+    <tr><td><strong>智能家居套装</strong></td><td><strong>以上全部打包</strong></td><td class=\"num-cell\"><strong>¥2,250</strong></td><td class=\"num-cell\"><strong>¥3,699</strong></td><td class=\"num-cell\" style=\"color:var(--red)\"><strong>¥1,449</strong></td></tr>\n+  </table>\n+\n+  <h3>3.3 套餐组合策略</h3>\n+  <div class=\"kpi-grid\">\n+    <div class=\"kpi-card\">\n+      <div class=\"value\" style=\"font-size:1.2em\">经济套餐</div>\n+      <div class=\"label\">智能马桶(入门) ¥1,699<br>≈ 单买价</div>\n+    </div>\n+    <div class=\"kpi-card\">\n+      <div class=\"value\" style=\"font-size:1.2em\">舒适套餐</div>\n+      <div class=\"label\">智能马桶(中端) ¥2,199<br>+ 智能门锁 ¥1,299<br>= <strong>套餐价 ¥3,199</strong>（省¥299）</div>\n+    </div>\n+    <div class=\"kpi-card\">\n+      <div class=\"value\" style=\"font-size:1.2em\">尊享套餐</div>\n+      <div class=\"label\">智能马桶(中高端) ¥3,299<br>+ 全屋智能套装 ¥3,699<br>= <strong>套餐价 ¥6,499</strong>（省¥499）</div>\n+    </div>\n+    <div class=\"kpi-card\">\n+      <div class=\"value\" style=\"font-size:1.2e